# Copy to .env and fill in the Atlas password once you have credentials.
# Leave MONGO_URI empty to run the whole platform on the in-memory store.
MONGO_URI=mongodb+srv://manzar9101_db_user:<db_password>@clusternew.o41rkap.mongodb.net/
# The <db_password> placeholder above is replaced with this, URL-escaped.
MONGO_PASSWORD=
MONGO_DB_NAME=user-info
MONGO_USERS_COLLECTION=user-details
PORT=5000
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
